[Unit]
Description=TPPD BTC Thursday option-buying paper tracker (no real orders)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/btc_bot
ExecStart=/home/ubuntu/btc_bot/.venv/bin/python thursday_paper.py
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target
