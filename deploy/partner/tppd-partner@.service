[Unit]
Description=TPPD nightly strangle for partner %i
After=network-online.target
Wants=network-online.target

[Service]
User=tp-%i
WorkingDirectory=/home/ubuntu/btc_partners/%i
Environment=BOT_ENV_FILE=/home/ubuntu/btc_partners/%i/instance.env
# Delta key and secret: sealed by tppd-partner-activate, readable only by this service, in memory only
LoadCredentialEncrypted=delta_api_key:/etc/tppd/creds/%i.key.cred
LoadCredentialEncrypted=delta_api_secret:/etc/tppd/creds/%i.secret.cred
ExecStart=/home/ubuntu/btc_bot/.venv/bin/python /home/ubuntu/btc_bot/condor.py
Restart=always
RestartSec=20
MemoryMax=300M
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/btc_partners/%i/data
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
