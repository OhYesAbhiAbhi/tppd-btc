#!/bin/bash
# Root-only. Usage: tppd-partner-activate <slug>
# Opens the partner's browser-made envelope with the vault key, seals key + secret as systemd encrypted
# credentials (tied to this server), writes the instance settings, and starts tppd-partner@<slug>.
set -euo pipefail
[ -c /dev/null ] || { echo "STOP: /dev/null is not a device - repair it first: rm -f /dev/null && mknod -m 666 /dev/null c 1 3"; exit 4; }
S="$1"; [[ "$S" =~ ^[a-z0-9-]{1,30}$ ]] || { echo "bad name"; exit 2; }
H=/home/ubuntu; P="$H/btc_partners/$S"; PY="$H/btc_bot/.venv/bin/python"
id "tp-$S" >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin -G tppd-partners "tp-$S"
mkdir -p "$P/data" /etc/tppd/creds && chmod 700 /etc/tppd/creds && chmod 755 "$P"
chown "tp-$S:tp-$S" "$P/data" && chmod 750 "$P/data" && setfacl -m u:ubuntu:rx "$P/data" && setfacl -d -m u:ubuntu:r "$P/data"
ENV_JSON=$(sqlite3 "$H/btc_partners/portal.db" "SELECT envelope FROM partners WHERE slug='$S' AND status IN ('pending','active')")
[ -n "$ENV_JSON" ] || { echo "no envelope for $S"; exit 3; }
KS=$(echo "$ENV_JSON" | "$PY" "$H/btc_bot/partner_vault.py" open /etc/tppd/vault.key)
KEY=$(echo "$KS" | "$PY" -c 'import json,sys;print(json.load(sys.stdin)["key"],end="")')
SEC=$(echo "$KS" | "$PY" -c 'import json,sys;print(json.load(sys.stdin)["secret"],end="")')
unset KS ENV_JSON
D="/etc/systemd/system/tppd-partner@$S.service.d"; mkdir -p "$D"
# probe into a temp file: systemd-creds REPLACES its output file (never point it at /dev/null)
PROBE=$(mktemp /etc/tppd/creds/.probe.XXXXXX)
if command -v systemd-creds >/dev/null 2>&1 && printf x | systemd-creds encrypt --name=t - "$PROBE" 2>/dev/null; then
    rm -f "$PROBE"
    printf %s "$KEY" | systemd-creds encrypt --name=delta_api_key - "/etc/tppd/creds/$S.key.cred"
    printf %s "$SEC" | systemd-creds encrypt --name=delta_api_secret - "/etc/tppd/creds/$S.secret.cred"
    chmod 600 "/etc/tppd/creds/$S.key.cred" "/etc/tppd/creds/$S.secret.cred"
    printf '[Service]\nLoadCredentialEncrypted=delta_api_key:/etc/tppd/creds/%s.key.cred\nLoadCredentialEncrypted=delta_api_secret:/etc/tppd/creds/%s.secret.cred\n' "$S" "$S" > "$D/creds.conf"
    HOW="encrypted (systemd-creds)"
else
    rm -f "$PROBE"
    ( umask 077; printf %s "$KEY" > "/etc/tppd/creds/$S.key"; printf %s "$SEC" > "/etc/tppd/creds/$S.secret" )
    printf '[Service]\nLoadCredential=delta_api_key:/etc/tppd/creds/%s.key\nLoadCredential=delta_api_secret:/etc/tppd/creds/%s.secret\n' "$S" "$S" > "$D/creds.conf"
    HOW="root-only file (this Ubuntu has no systemd-creds)"
fi
unset KEY SEC
SLOT=$(ls /etc/systemd/system/ | grep -c "^tppd-partner@.*\.service\.d$")
# strategy = the owner's settings (CONDOR_*, FEE_*, GST), minus anything per-partner; then partner overrides
grep -E '^(CONDOR_|FEE_|GST)' "$H/btc_bot/.env" | grep -vE '^CONDOR_(DATA_DIR|CONTROL_FILE|ALERTS|ENTRY_DELAY_SEC|AUTO_PAPER|MAX_LOTS|STOP_PER_LOT)=' > "$P/instance.env.tmp"
cat >> "$P/instance.env.tmp" <<E2
DELTA_ENV=prod
CONDOR_MODE=live
CONDOR_DATA_DIR=$P/data
CONDOR_CONTROL_FILE=$P/control.json
CONDOR_ALERTS=off
CONDOR_AUTO_PAPER=on
CONDOR_MAX_LOTS=100000
CONDOR_STOP_PER_LOT=0.90
CONDOR_ENTRY_DELAY_SEC=$((60 * SLOT))
E2
mv "$P/instance.env.tmp" "$P/instance.env" && chmod 644 "$P/instance.env"
systemctl daemon-reload && systemctl enable --now "tppd-partner@$S"
echo "started tppd-partner@$S (entry delay $((60 * SLOT)) s, key: $HOW)"
