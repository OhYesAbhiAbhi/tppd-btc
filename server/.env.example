# Copy to .env on the server:  cp .env.example .env && chmod 600 .env
# Never commit or share .env.

# --- Delta API key (create at demo.delta.exchange for testnet, delta.exchange for prod)
DELTA_API_KEY=
DELTA_API_SECRET=

# Stage 1: MODE=paper  DELTA_ENV=prod      -> real market data, no orders
# Stage 2: MODE=live   DELTA_ENV=testnet   -> real orders on the demo account (testnet key)
# Stage 3: MODE=live   DELTA_ENV=prod      -> real money (prod key)
MODE=paper
DELTA_ENV=prod

HEDGE=compare               # off = naked, on = credit spread, compare = both (paper only)
RUNNER=true                  # hold strong winners to expiry instead of taking 3%
STRANGLE=true                # sideways days: sell put + call (iron condor when HEDGE adds wings)

ORDER_SIZE=1                 # contracts per trade (1 contract = 0.001 BTC)
MAX_DAILY_LOSS_USD=20

# Exits
TP_NET_PCT=0.03              # 3% of premium AFTER fees
SL_PCT=0.10
MAX_HOLD_MIN=240

# Optional: Telegram alerts to your phone
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
